# ── Navegador (públicas) ────────────────────────────────────────────
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── Servidor (funções /api na Vercel) — NUNCA com prefixo VITE_ ─────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...).
# Use a chave NOVA (sb_secret_), não a service_role antiga: só ela permite
# repassar o IP de quem faz login (limite por IP do Supabase; ver docs/DEPLOY.md).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
